SCHOOL_AGE_FROM=6
SCHOOL_AGE_TO=21

# 기본값은 KOSIS 우선입니다. KOSIS URL이 없거나 응답을 읽지 못하면 행안부 주민등록 1세 단위 CSV로 대체됩니다.
# SCHOOL_AGE_DATA_SOURCE=kosis

# 선택: KOSIS 통계자료 API 키와 통계표 선택 URL 템플릿.
# KOSIS_SCHOOL_AGE_URL_TEMPLATE에는 아래 치환값을 넣을 수 있습니다.
# {apiKey}, {year}, {admCd}, {admCd2}, {lawdCd}, {featureCd}, {sggNm}, {admNm}, {featureNm}, {group}, {ageFrom}, {ageTo}
# KOSIS_API_KEY=발급받은_KOSIS_보안_Key
# KOSIS_SCHOOL_AGE_URL_TEMPLATE=https://kosis.kr/openapi/Param/statisticsParameterData.do?method=getList&apiKey={apiKey}&format=json&jsonVD=Y&prdSe=Y&newEstPrdCnt=1&...

# 선택: 학령인구 3D 지도 연도 범위를 서버에서 강제로 바꾸고 싶을 때만 사용하세요.
# MOIS_STATS_START_YEAR=2008
# MOIS_OBSERVED_LATEST_YEAR=2026
# MOIS_FORECAST_LATEST_YEAR=2072

# 선택: 공공데이터포털(data.go.kr) 행정안전부 주민등록 API 인증키.
# 법정동/리 경계 GeoJSON을 추가해 공공데이터 법정동 코드와 매칭할 때만 필요합니다.
# DATA_GO_KR_SERVICE_KEY=발급받은_공공데이터포털_Encoding_인증키
