SCHOOL_AGE_FROM=6
SCHOOL_AGE_TO=21

# 선택: 학령인구 3D 지도 연도 범위를 서버에서 강제로 바꾸고 싶을 때만 사용하세요.
# KOSIS_STATS_START_YEAR=2000
# KOSIS_OBSERVED_LATEST_YEAR=2024
# KOSIS_FORECAST_LATEST_YEAR=2072

# KOSIS 공식 연령별/학령구간 API URL이 확정되면 서버에서만 사용하세요.
# KOSIS_API_KEY=발급받은_KOSIS_OpenAPI_Key
# KOSIS_SCHOOL_AGE_URL_TEMPLATE=https://kosis.kr/openapi/statisticsData.do?...{apiKey}...{year}...{admCd}...{ageFrom}...{ageTo}
