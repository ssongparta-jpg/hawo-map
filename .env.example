SGIS_CONSUMER_KEY=서비스_ID를_여기에_넣으세요
SGIS_CONSUMER_SECRET=보안_Key를_여기에_넣으세요

SCHOOL_AGE_FROM=6
SCHOOL_AGE_TO=21

# 선택: 화면의 연도 슬라이더 범위를 서버에서 강제로 바꾸고 싶을 때만 사용하세요.
# SGIS_STATS_START_YEAR=2000
# SGIS_STATS_LATEST_YEAR=2024

# SGIS 기본 인구 API가 원하는 값을 주지 않을 때만 공식 URL 템플릿을 지정하세요.
# KOSTAT_SCHOOL_AGE_URL_TEMPLATE=https://...{accessToken}...{admCd}...{ageFrom}...{ageTo}
